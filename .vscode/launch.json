{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Scan2Mesh: NKSR direkt (Standard)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "python": "${env:LOCALAPPDATA}/Scan2Mesh/venv/Scripts/python.exe"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "Scan2Mesh: Umgebung vorbereiten",
      "env": {
        "OMP_NUM_THREADS": "4"
      },
      "justMyCode": true
    }
  ]
}
